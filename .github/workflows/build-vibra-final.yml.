name: Vibra iOS - Build IPA FINAL

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: macos-latest

    steps:

      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Check Xcode
        run: |
          xcodebuild -version
          xcode-select -p

      - name: Analyze project
        run: |
          echo "=== PROJECT FILES ==="
          find . -maxdepth 3 -type f | sort | head -300

      - name: Recreate Xcode project structure
        run: |
          set -e

          echo "=== CHECK PROJECT ==="

          if [ ! -f "project.pbxproj" ]; then
            echo "project.pbxproj non trovato"
            exit 1
          fi

          mkdir -p "Vibra.xcodeproj"
          cp "project.pbxproj" "Vibra.xcodeproj/project.pbxproj"

          mkdir -p "Vibra.xcodeproj/xcshareddata/xcschemes"

          if [ -f "Vibra.xcscheme" ]; then
            cp "Vibra.xcscheme" \
              "Vibra.xcodeproj/xcshareddata/xcschemes/Vibra.xcscheme"
          fi

          echo "=== XCODE PROJECT CREATED ==="
          find "Vibra.xcodeproj" -maxdepth 5 -type f

      - name: Install CocoaPods
        run: |
          sudo gem install cocoapods
          pod --version

      - name: Install Pods
        run: |
          if [ -f "Podfile" ]; then
            pod install
          else
            echo "Podfile non trovato"
          fi

      - name: Verify workspace
        run: |
          echo "=== WORKSPACE ==="
          find . -maxdepth 3 -type d -name "*.xcworkspace" -print
          find . -maxdepth 3 -type f -name "*.xcworkspace" -print

      - name: Create signing keychain
        env:
          KEYCHAIN_PASSWORD: ${{ secrets.KEYCHAIN_PASSWORD }}
        run: |
          security create-keychain \
            -p "$KEYCHAIN_PASSWORD" \
            build.keychain

          security set-keychain-settings \
            -lut 21600 \
            build.keychain

          security unlock-keychain \
            -p "$KEYCHAIN_PASSWORD" \
            build.keychain

          security list-keychains -d user -s \
            build.keychain login.keychain-db

      - name: Import Apple Distribution certificate
        env:
          BUILD_CERTIFICATE_BASE64: ${{ secrets.BUILD_CERTIFICATE_BASE64 }}
          P12_PASSWORD: ${{ secrets.P12_PASSWORD }}
          KEYCHAIN_PASSWORD: ${{ secrets.KEYCHAIN_PASSWORD }}
        run: |
          echo "$BUILD_CERTIFICATE_BASE64" | base64 --decode \
            > certificate.p12

          security import certificate.p12 \
            -k build.keychain \
            -P "$P12_PASSWORD" \
            -T /usr/bin/codesign \
            -T /usr/bin/security

          security set-key-partition-list \
            -S apple-tool:,apple: \
            -s \
            -k "$KEYCHAIN_PASSWORD" \
            build.keychain

          security find-identity \
            -v -p codesigning \
            build.keychain

      - name: Install provisioning profile
        env:
          BUILD_PROVISION_PROFILE_BASE64: ${{ secrets.BUILD_PROVISION_PROFILE_BASE64 }}
        run: |
          mkdir -p "$HOME/Library/MobileDevice/Provisioning Profiles"

          echo "$BUILD_PROVISION_PROFILE_BASE64" | base64 --decode \
            > profile.mobileprovision

          PROFILE_UUID=$(
            security cms -D -i profile.mobileprovision |
            /usr/libexec/PlistBuddy -c "Print:UUID"
          )

          cp profile.mobileprovision \
            "$HOME/Library/MobileDevice/Provisioning Profiles/$PROFILE_UUID.mobileprovision"

          echo "=== PROFILE UUID ==="
          echo "$PROFILE_UUID"

      - name: Configure app signing
        run: |
          set -e

          echo "=== CONFIGURING SIGNING ==="

          xcodebuild \
            -project "Vibra.xcodeproj" \
            -target "Vibra" \
            DEVELOPMENT_TEAM="MA8PHU39TR" \
            CODE_SIGN_STYLE="Manual" \
            CODE_SIGN_IDENTITY="Apple Distribution" \
            PROVISIONING_PROFILE_SPECIFIER="VibraAppStoreNew" \
            PRODUCT_BUNDLE_IDENTIFIER="com.vibraalienmatch" \
            build-settings

      - name: Create entitlements
        run: |
          cat > Entitlements.plist <<'EOF'
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
          <plist version="1.0">
          <dict>
          </dict>
          </plist>
          EOF

      - name: Archive iOS app
        run: |
          set -o pipefail

          xcodebuild \
            -project "Vibra.xcodeproj" \
            -scheme "Vibra" \
            -configuration Release \
            -sdk iphoneos \
            -archivePath "$PWD/build/Vibra.xcarchive" \
            DEVELOPMENT_TEAM="MA8PHU39TR" \
            CODE_SIGN_STYLE="Manual" \
            CODE_SIGN_IDENTITY="Apple Distribution" \
            PROVISIONING_PROFILE_SPECIFIER="VibraAppStoreNew" \
            PRODUCT_BUNDLE_IDENTIFIER="com.vibraalienmatch" \
            clean archive \
            | tee archive.log

      - name: Create ExportOptions.plist
        run: |
          cat > ExportOptions.plist <<'EOF'
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
          <plist version="1.0">
          <dict>
              <key>method</key>
              <string>app-store</string>

              <key>signingStyle</key>
              <string>manual</string>

              <key>teamID</key>
              <string>MA8PHU39TR</string>

              <key>provisioningProfiles</key>
              <dict>
                  <key>com.vibraalienmatch</key>
                  <string>VibraAppStoreNew</string>
              </dict>
          </dict>
          </plist>
          EOF

      - name: Export IPA
        run: |
          set -o pipefail

          xcodebuild \
            -exportArchive \
            -archivePath "$PWD/build/Vibra.xcarchive" \
            -exportPath "$PWD/build/export" \
            -exportOptionsPlist ExportOptions.plist \
            | tee export.log

      - name: Show generated files
        run: |
          echo "=== GENERATED FILES ==="
          find build -type f -maxdepth 5 -print

      - name: Upload IPA
        uses: actions/upload-artifact@v4
        with:
          name: Vibra-iOS-IPA-FINAL
          path: build/export/*.ipa
          if-no-files-found: error

      - name: Upload build logs
        uses: actions/upload-artifact@v4
        with:
          name: Vibra-iOS-Build-Logs-FINAL
          path: |
            archive.log
            export.log
